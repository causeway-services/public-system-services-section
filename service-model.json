{
  "version": "1.0.0",
  "service": "trusted-personal-executive-assistance",
  "target": "executive-assistant + private-chief-of-staff + personal-operations",
  "activeLifecycle": [
    "active",
    "waiting_external",
    "requires_client"
  ],
  "terminalLifecycle": [
    "done",
    "canceled",
    "superseded",
    "abandoned"
  ],
  "rules": {
    "terminalItemsMustLeaveFrontier": true,
    "unchangedExternalWaitsStaySilentUntilWake": true,
    "unchangedClientGatesStaySilentUntilDeadlineNewEvidenceOrEscalation": true,
    "statusChecksDoNotCountWithoutStateChange": true,
    "providerNativeStateOutranksProjection": true,
    "closedRoutineTransactionsDoNotRequireCeremonialFollowup": true
  },
